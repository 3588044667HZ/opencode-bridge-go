# Required. Use a long random value, for example: openssl rand -hex 32
LAPTOP_MCP_TOKEN=replace-with-a-long-random-mcp-token

# MCP loopback port.
BRIDGE_PORT=8765

# Data root and file-tool workspace. Relative paths resolve from the current directory.
BRIDGE_DATA_DIR=data
BRIDGE_WORKSPACE=data/workspace

# Optional HTTP file service. Leave BRIDGE_FILES_TOKEN unset/empty to disable it.
# BRIDGE_FILES_TOKEN=replace-with-a-different-long-random-files-token
BRIDGE_FILES_PORT=8766
BRIDGE_MAX_FILE_BYTES=536870912
BRIDGE_STAGING_QUOTA_BYTES=2147483648

# Windows screenshot backend: auto, ffmpeg, or powershell.
BRIDGE_SCREENSHOT_BACKEND=auto

# Optional shell alias. It must be detected on this host.
# BRIDGE_SHELL=powershell
